# copy this file to .env and fill in the values before running locally

POSTGRES_DB=penelope_db
POSTGRES_PORT=5432

# bootstrap superuser used by postgres container on first volume init
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_BOOTSTRAP_PASSWORD

# schema owner for running migrations (non-superuser)
POSTGRES_OWNER_USER=penelope_owner
POSTGRES_OWNER_PASSWORD=CHANGE_ME_OWNER_PASSWORD
MIGRATION_DATABASE_URL=postgres://penelope_owner:CHANGE_ME_OWNER_PASSWORD@localhost:5432/penelope_db

# app runtime user (restricted dml, no ddl)
POSTGRES_APP_USER=penelope_app
POSTGRES_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
DATABASE_URL=postgres://penelope_app:CHANGE_ME_APP_PASSWORD@localhost:5432/penelope_db

# backend server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
RUST_LOG=penelope_backend=debug,tower_http=info
RUN_MIGRATIONS_ON_STARTUP=false

# session cookie secret (min 32 characters, generate with `openssl rand -hex 32`)
SESSION_SECRET=CHANGE_ME_GENERATE_64_CHAR_SECRET_WITH_OPENSSL_RAND_HEX_32

# aes-256-gcm field encryption keyring (<key_id>:<64_hex_chars>)
# NOTE: generate a real 32-byte key with `openssl rand -hex 32` (all-zero keys get rejected on startup)
PENELOPE_ACTIVE_KEY_ID=1
PENELOPE_ENCRYPTION_KEYS=1:CHANGE_ME_GENERATE_64_HEX_CHAR_KEY_WITH_OPENSSL_RAND_HEX_32

# first-run admin bootstrap (only runs when users table is empty)
BOOTSTRAP_INITIAL_ADMIN=false
INITIAL_ADMIN_EMAIL=admin@penelope.local
INITIAL_ADMIN_PASSWORD=CHANGE_ME_MIN_12_CHAR_ADMIN_PASS
INITIAL_ADMIN_NAME=System Administrator

# app defaults & rate limits
DEFAULT_CURRENCY_CODE=EUR
SEED_DEMO_DATA=false
SESSION_IDLE_TTL_HOURS=24
SESSION_ABSOLUTE_TTL_HOURS=168
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_API_PER_MIN=120
